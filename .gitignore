# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.codex-artifacts/
audit-screenshots-responsive/
.pnpm-store/
cloudflare/.generated/
cloudflare/.wrangler/
__pycache__/
.supabase/
public/images/books-cover/FINDER.DAT
public/images/persons/FINDER.DAT

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
cloudflare/.dev.vars

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

supabase/*
!supabase/migrations/
!supabase/migrations/*.sql
supabase/.temp/

.vercel
